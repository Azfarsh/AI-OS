# Claude Code — pick one auth mode (see references/claude-code-api.md)
#
# Direct Anthropic Console:
# ANTHROPIC_API_KEY=
#
# OpenRouter (recommended if you have sk-or-v1-... keys):
OPENROUTER_API_KEY=
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=

# ClickUp
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=
CLICKUP_SPACE_ID=

# Google Drive / Gmail (Service Account)
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=agency-service-account.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_NOTES_FOLDER_ID=

# DocuSeal
DOCUSEAL_API_TOKEN=
DOCUSEAL_TEMPLATE_ID=

# Meta Ads
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Bombay Media

# Agency defaults
AGENCY_NAME=Bombay Media
AGENCY_EMAIL=
