# ── Environment & secrets ─────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
# Keep the committed template; ignore any other .env variants
.env.*
!.env.example

# ── API keys & service accounts ───────────────────────────────────
agency-service-account.json
*-service-account.json
*-credentials.json
credentials/
*.pem
*.key
*.p12

# Google Ads local config (generated from .env)
scripts/.google-ads.yaml

# ── Local Claude / Cursor config ──────────────────────────────────
.claude/settings.local.json
CLAUDE.local.md

# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
dist/
build/
*.egg-info/

# ── Node (if added later) ─────────────────────────────────────────
node_modules/

# ── OS & editor noise ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.log

# ── Agency OS runtime ─────────────────────────────────────────────
audits/

# Client temp pulls (deleted by /report)
clients/**/reports/.tmp-*.json
